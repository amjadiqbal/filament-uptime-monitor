{
    "name": "amjadiqbal/filament-uptime-monitor",
    "description": "A Filament 4 and 5 admin UI for spatie/laravel-uptime-monitor: add, edit, enable, disable and check uptime and SSL certificate monitors from your panel.",
    "keywords": [
        "filament",
        "filament-plugin",
        "filamentphp",
        "laravel",
        "uptime",
        "uptime-monitor",
        "monitoring",
        "ssl-certificate",
        "website-monitoring",
        "status"
    ],
    "homepage": "https://github.com/amjadiqbal/filament-uptime-monitor",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Amjad Iqbal",
            "homepage": "https://amjad.com.pk",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/amjadiqbal/filament-uptime-monitor/issues",
        "source": "https://github.com/amjadiqbal/filament-uptime-monitor"
    },
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0|^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16",
        "spatie/laravel-uptime-monitor": "^4.6"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "AmjadIqbal\\FilamentUptimeMonitor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AmjadIqbal\\FilamentUptimeMonitor\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint --test",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AmjadIqbal\\FilamentUptimeMonitor\\FilamentUptimeMonitorServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
